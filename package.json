    "worker:email": "tsx src/workers/email-worker.ts",
    "worker:maintenance": "tsx src/workers/maintenance-worker.ts",
    "prepare": "node -e \"const fs=require('node:fs'); if (fs.existsSync('.git')) require('node:child_process').execSync('lefthook install',{stdio:'inherit'});\""
  },
  "dependencies": {
